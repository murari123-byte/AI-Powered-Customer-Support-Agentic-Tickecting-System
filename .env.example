# Copy this file to .env and adjust values:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Both the backend and the frontend read this one file.

# ---------- Backend ----------
# Display name returned by /health and shown in the API docs.
APP_NAME=AI Support Platform
# development | test | production
APP_ENV=development
APP_VERSION=0.1.0
# Comma-separated browser origins allowed to call the API (CORS). Must match the frontend URL.
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL + pgvector in Docker) ----------
# Used by BOTH docker-compose.yml (to create the database) and the backend (to connect).
POSTGRES_USER=support
# Required. Pick your own, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Changing it after the container was first created has no effect; see docs/troubleshooting.md.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support
# Where the backend finds PostgreSQL. 5433 (not 5432) avoids clashing with another local PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Empty database used only by pytest. Created automatically the first time the container starts.
TEST_POSTGRES_DB=support_test
# Optional full URL (e.g. AWS RDS). When set, the POSTGRES_* connection parts above are ignored.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---------- Authentication ----------
# Required, at least 32 characters. Signs access tokens: anyone who knows it can log in as anyone.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out (existing access tokens stop working).
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
# Access token lifetime in minutes (1-60). Short on purpose.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days (1-30). The user must log in again after this.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Send the refresh cookie only over HTTPS. Browsers treat http://localhost as secure, so keep true.
AUTH_COOKIE_SECURE=true
# Limit login (10/min) and sign-up (5/hour) attempts per IP address, using Redis. Keep true.
RATE_LIMIT_ENABLED=true

# ---------- Knowledge base (RAG) ----------
# Chunk size and overlap in characters (about 4 characters per word-piece/token).
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# How many chunks the LLM gets as sources.
RAG_TOP_K=4
# Chunks less similar than this (0-1) are ignored; if none are left the answer is "I don't know"
# without calling the LLM. Tuned with: python -m evals.run_rag
RAG_MIN_SIMILARITY=0.55
# Largest file an admin can upload, in MB.
KNOWLEDGE_MAX_UPLOAD_MB=5

# ---------- Tickets ----------
# Days after a ticket is RESOLVED during which the customer may still reopen it (0-90).
TICKET_REOPEN_WINDOW_DAYS=7

# ---------- Redis + Celery (background jobs) ----------
# Where the backend and the Celery worker find Redis.
REDIS_HOST=localhost
# Also the host port Docker publishes Redis on. 6380 (not 6379) avoids clashing with another Redis.
REDIS_PORT=6380
# How often the SLA check runs, in seconds (minimum 10).
SLA_CHECK_INTERVAL_SECONDS=300

# ---------- AI (local Ollama, free, no API key) ----------
# Only "ollama" exists today. Other providers plug in without changing the rest of the app.
AI_PROVIDER=ollama
# Where the Ollama server listens. Start it with: scripts/ollama.sh serve
OLLAMA_BASE_URL=http://localhost:11434
# Chat model used for classification and answers. Download: scripts/ollama.sh pull qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Embedding model for RAG (768 dimensions). Download: scripts/ollama.sh pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window in tokens (2048-131072). Ollama's own default is small and silently cuts prompts.
OLLAMA_NUM_CTX=8192
# 0.0-2.0. Low = predictable output, which classification needs.
AI_TEMPERATURE=0.1
# Seconds to wait for one model reply. CPU-only machines are slow; keep this generous.
AI_TIMEOUT_SECONDS=120
# Extra attempts (0-3) when the model returns JSON that fails validation.
AI_MAX_OUTPUT_RETRIES=1
# Classify every new ticket with the AI in the background (needs the Celery worker). true / false
AI_TRIAGE_ENABLED=true
# The AI's answer is only used when its confidence is at least this (0.0-1.0). Below it, a person decides.
AI_CONFIDENCE_THRESHOLD=0.7

# ---------- Docker ----------
# Host port for the frontend container (http://localhost:<port>). Change it if 8080 is already used.
FRONTEND_PORT=8080

# ---------- Monitoring (Docker) ----------
# Required for `docker compose up`: password of the Grafana "admin" user (http://localhost:3002).
GRAFANA_ADMIN_PASSWORD=change-me

# ---------- Frontend ----------
# Only variables starting with VITE_ are sent to the browser. Never put secrets in them.
VITE_API_BASE_URL=http://localhost:8000
